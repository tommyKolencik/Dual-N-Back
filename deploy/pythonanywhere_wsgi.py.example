"""Paste into PythonAnywhere's WSGI configuration, replacing YOUR_USERNAME.

Set up the virtualenv and enable Force HTTPS in the Web tab first.
For an EU account, use YOUR_USERNAME.eu.pythonanywhere.com below.
"""

import os
import sys
from pathlib import Path

project_path = Path("/home/YOUR_USERNAME/N-back")
data_path = Path("/home/YOUR_USERNAME/nback-data")
data_path.mkdir(mode=0o700, parents=True, exist_ok=True)
sys.path.insert(0, str(project_path))

os.environ["NBACK_DATABASE"] = str(data_path / "nback.db")
os.environ["NBACK_COOKIE_SECURE"] = "1"
os.environ["NBACK_PUBLIC_ORIGIN"] = "https://YOUR_USERNAME.pythonanywhere.com"
os.environ["NBACK_TRUSTED_HOSTS"] = "YOUR_USERNAME.pythonanywhere.com"

from wsgi import application
